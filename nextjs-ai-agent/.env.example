# Copy to .env.local for local development. In production, set these in the Vercel project.
# Live origin without a trailing slash. Drives canonical URLs, sitemap, RSS and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Contact form delivery through Resend (https://resend.com). Leave empty until you have them;
# the form then shows an honest "not connected" message instead of pretending to send.
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@yourdomain.com
# Optional. A sender address on a domain you verified in Resend. Defaults to onboarding@resend.dev.
CONTACT_FROM_EMAIL=
